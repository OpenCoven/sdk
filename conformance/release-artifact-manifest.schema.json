{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencoven:schema:release-artifact-manifest:3",
  "title": "OpenCoven release artifact manifest",
  "description": "Separates the frozen private-source conformance artifact set from an immutable publication candidate produced before and later bound by the external security review.",
  "oneOf": [
    {
      "$ref": "#/$defs/conformanceArtifactSet"
    },
    {
      "$ref": "#/$defs/publicationArtifactSet"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "positiveId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "fileMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9@._/-]+$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "file",
        "size",
        "sha256"
      ],
      "properties": {
        "name": {
          "enum": [
            "@opencoven/sdk-core",
            "@opencoven/cave-client",
            "@opencoven/coven-client",
            "@opencoven/sdk"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9@._/-]+$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifactList": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "conformanceArtifactSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "version",
        "packages"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "packages": {
          "$ref": "#/$defs/artifactList"
        }
      }
    },
    "publicationArtifactSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "artifactSet",
        "version",
        "source",
        "toolchain",
        "provenance",
        "packages"
      ],
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "artifactSet": {
          "const": "publication-candidate"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "commit",
            "tree",
            "npmConfigFiles"
          ],
          "properties": {
            "repository": {
              "const": "OpenCoven/sdk"
            },
            "commit": {
              "$ref": "#/$defs/gitOid"
            },
            "tree": {
              "$ref": "#/$defs/gitOid"
            },
            "npmConfigFiles": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [
                {
                  "allOf": [
                    {
                      "$ref": "#/$defs/fileMetadata"
                    },
                    {
                      "properties": {
                        "path": {
                          "const": ".npmrc"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          }
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodeVersion",
            "pnpmVersion",
            "npmVersion",
            "packCommand"
          ],
          "properties": {
            "nodeVersion": {
              "const": "v24.18.1"
            },
            "pnpmVersion": {
              "const": "pnpm@10.34.0"
            },
            "npmVersion": {
              "const": "11.5.1"
            },
            "packCommand": {
              "const": "corepack pnpm@10.34.0 pack --ignore-scripts"
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "workflow",
            "workflowCommit",
            "sourceRef",
            "runId",
            "runAttempt",
            "job",
            "artifactName"
          ],
          "properties": {
            "repository": {
              "const": "OpenCoven/sdk"
            },
            "workflow": {
              "const": ".github/workflows/release.yml"
            },
            "workflowCommit": {
              "$ref": "#/$defs/gitOid"
            },
            "sourceRef": {
              "const": "refs/heads/main"
            },
            "runId": {
              "$ref": "#/$defs/positiveId"
            },
            "runAttempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "job": {
              "const": "publication-candidate"
            },
            "artifactName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 192,
              "pattern": "^opencoven-sdk-publication-[0-9a-f]{40}-(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
            }
          }
        },
        "packages": {
          "$ref": "#/$defs/artifactList"
        }
      }
    }
  }
}
