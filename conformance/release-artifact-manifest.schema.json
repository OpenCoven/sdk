{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencoven:schema:release-artifact-manifest:2",
  "title": "OpenCoven release artifact manifest",
  "description": "Separates the frozen private-source conformance artifact set from a later publication candidate built from the exact security-reviewed unlock commit.",
  "oneOf": [
    {
      "$ref": "#/$defs/conformanceArtifactSet"
    },
    {
      "$ref": "#/$defs/publicationArtifactSet"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "file",
        "size",
        "sha256"
      ],
      "properties": {
        "name": {
          "enum": [
            "@opencoven/sdk-core",
            "@opencoven/cave-client",
            "@opencoven/coven-client",
            "@opencoven/sdk"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9@._/-]+$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifactList": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "conformanceArtifactSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "version",
        "packages"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "packages": {
          "$ref": "#/$defs/artifactList"
        }
      }
    },
    "publicationArtifactSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "artifactSet",
        "version",
        "source",
        "securityReview",
        "packages"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "artifactSet": {
          "const": "publication-candidate"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "commit",
            "tree"
          ],
          "properties": {
            "repository": {
              "const": "OpenCoven/sdk"
            },
            "commit": {
              "$ref": "#/$defs/gitOid"
            },
            "tree": {
              "$ref": "#/$defs/gitOid"
            }
          }
        },
        "securityReview": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issue",
            "commentId",
            "reviewer",
            "reviewedCommit"
          ],
          "properties": {
            "issue": {
              "const": "OpenCoven/sdk#40"
            },
            "commentId": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "reviewer": {
              "const": "BunsDev"
            },
            "reviewedCommit": {
              "$ref": "#/$defs/gitOid"
            }
          }
        },
        "packages": {
          "$ref": "#/$defs/artifactList"
        }
      }
    }
  }
}
