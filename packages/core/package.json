{
  "name": "@opencoven/sdk-core",
  "version": "0.1.0",
  "description": "Transport-neutral OpenCoven SDK primitives",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE-AGPL",
    "LICENSE-MIT",
    "package.json"
  ],
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenCoven/sdk.git",
    "directory": "packages/core"
  },
  "license": "AGPL-3.0-or-later OR MIT",
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc --pretty false --noEmit -p tsconfig.json"
  }
}
