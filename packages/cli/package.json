{
  "name": "@opencoven/dev-cli",
  "version": "0.1.0",
  "description": "OpenCoven developer CLI foundation",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "opencoven": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE-AGPL",
    "LICENSE-MIT",
    "package.json"
  ],
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenCoven/sdk.git",
    "directory": "packages/cli"
  },
  "license": "AGPL-3.0-or-later OR MIT",
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc --pretty false --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@opencoven/sdk-core": "workspace:0.1.0"
  }
}
